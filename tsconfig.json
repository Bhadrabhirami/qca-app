{
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "react-jsx", // This is critical for the jsx-runtime
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true
  },
  "include": ["src", "app"]
}