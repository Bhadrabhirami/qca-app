# Dependencies
node_modules/

# Build output (Vite) — regenerated by `npm run build`
dist/

# Android build artifacts and secrets are handled by android/.gitignore.
# The android/ project itself IS committed (manifest, network config, Gradle files).

# Signing secrets — never commit (belt and braces with android/.gitignore)
*.jks
*.keystore
*.p12
*.pem
*.key
keystore.properties

# Local environment / machine-specific
.env
.env.*
local.properties
.expo/

# Local databases and temp data
*.db
*.db-journal

# Editors / IDEs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.iml

# OS / logs
.DS_Store
Thumbs.db
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
*.tsbuildinfo

# Old one-off patch scripts (kept locally, not in git)
misc/scripts/
